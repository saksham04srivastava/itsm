# ─── Advantal Support — Environment Configuration ────────────────────────────
# Copy this file to .env and edit values before running docker compose

# Port the portal is exposed on (default: 80)
PORT=80

# JWT secret — CHANGE THIS in production to a long random string!
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Allowed CORS origins (comma-separated if multiple)
ALLOWED_ORIGINS=http://localhost
