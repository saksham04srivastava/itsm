# ─── Advantal Support — Environment Configuration ────────────────────────────

# Local port (default 80)
PORT=80

# PostgreSQL password
DB_PASSWORD=fieldops123

# JWT secret — CHANGE THIS in production!
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Set to true when the portal is served over HTTPS, so the file-download
# session cookie is only ever sent on secure connections.
COOKIE_SECURE=false

# ── Cloudflare Tunnel (for global access) ────────────────────────────────────
# Steps to get your token:
#   1. Go to https://one.dash.cloudflare.com
#   2. Zero Trust → Networks → Tunnels → Create a Tunnel
#   3. Name it "fieldops", choose Docker as environment
#   4. Copy the token from the docker run command shown (the long string after --token)
#   5. Paste it below
#
# Then start with tunnel:  docker compose --profile tunnel up -d
# Without tunnel (LAN only): docker compose up -d
#
CLOUDFLARE_TUNNEL_TOKEN=paste-your-token-here
